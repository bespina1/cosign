FROM golang:1.25

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl wget jq ripgrep && rm -rf /var/lib/apt/lists/*

RUN check_min() {       tool=$1 ; min=$2 ; actual=$3 ; ok=$(awk "BEGIN{ split(\"$actual\",a,\".\") ; split(\"$min\",m,\".\") ; for(i=1 ; i<=3 ; i++){ if(a[i]+0>m[i]+0){print 1 ; exit} if(a[i]+0<m[i]+0){print 0 ; exit} } ; print 1}") ; if [ "$ok" -ne 1 ] ; then         echo "FAIL: $tool $actual < minimum $min" >&2 ; exit 1 ; fi ; echo "OK: $tool $actual >= $min" ; } ; check_min git 2.25.0 "$(git --version | awk '{print $3}')" && check_min curl 7.70.0 "$(curl --version | head -1 | awk '{print $2}')" && check_min jq 1.6 "$(jq --version | sed 's/^jq-//')" && check_min rg 13.0.0 "$(rg --version | head -1 | awk '{print $2}')"

RUN check_min() {       tool=$1 ; min=$2 ; actual=$3 ; ok=$(awk "BEGIN{ split(\"$actual\",a,\".\") ; split(\"$min\",m,\".\") ; for(i=1 ; i<=3 ; i++){ if(a[i]+0>m[i]+0){print 1 ; exit} if(a[i]+0<m[i]+0){print 0 ; exit} } ; print 1}") ; if [ "$ok" -ne 1 ] ; then         echo "FAIL: $tool $actual < minimum $min" >&2 ; exit 1 ; fi ; echo "OK: $tool $actual >= $min" ; } ; check_min wget 1.20.0 "$(/usr/bin/wget --progress=dot:giga --version | head -1 | awk '{print $3}')"

COPY . .

RUN go mod download

CMD ["sh", "-c", "go test ./..."]
